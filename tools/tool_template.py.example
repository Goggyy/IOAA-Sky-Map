from __future__ import annotations

import sys
from pathlib import Path

if __package__ in {None, ""}:
    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from ioaa_trainer.tool_api import SkyTool


class ExampleTool(SkyTool):
    tool_id = "example_tool"
    title = "Example Tool"
    description = "Explain what this tool lets the student do."


TOOL_CLASS = ExampleTool


def create_widget():
    """Return a QWidget for the launcher's in-app navigation stack."""
    # Import your QWidget-based tool UI lazily here and return an instance.
    # Example:
    # from ioaa_trainer.your_tool_ui import YourToolApplication
    # return YourToolApplication()
    raise NotImplementedError("Implement this tool's embeddable QWidget.")


def run_tool() -> int:
    # Keep a standalone runner too, so the tool can still be launched directly.
    # The main app uses create_widget() instead.
    print("Implement this tool's UI in run_tool().")
    return 0


if __name__ == "__main__":
    raise SystemExit(run_tool())
